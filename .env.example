# Copy this to .env and edit. All settings read the DOCCHAT_ prefix.

# --- auth ---
DOCCHAT_AUTH_ENABLED=true
DOCCHAT_SECRET_KEY=generate-a-long-random-string
DOCCHAT_TOKEN_EXPIRY_MINUTES=10080

# --- embeddings: tfidf | openai | local ---
DOCCHAT_EMBEDDING_PROVIDER=tfidf
DOCCHAT_EMBEDDING_MODEL=text-embedding-3-small
DOCCHAT_OPENAI_API_KEY=
DOCCHAT_OPENAI_BASE_URL=https://api.openai.com/v1

# --- LLM: none | ollama | openai ---
DOCCHAT_LLM_PROVIDER=none
DOCCHAT_LLM_MODEL=llama3.1
DOCCHAT_OLLAMA_BASE_URL=http://localhost:11434
DOCCHAT_LLM_TEMPERATURE=0.2

# --- retrieval ---
DOCCHAT_DEFAULT_K=4
DOCCHAT_WORDS_PER_CHUNK=120
DOCCHAT_CHUNK_OVERLAP=30

# --- data ---
# Leave DOCCHAT_DATABASE_URL empty to use SQLite at DOCCHAT_DB_PATH.
# Set a Postgres URL to use Postgres, e.g.
#   DOCCHAT_DATABASE_URL=postgresql://user:pass@host:5432/docchat
DOCCHAT_DB_PATH=data/docchat.db
DOCCHAT_DOCS_DIR=sample_docs
DOCCHAT_SEED_DEMO_USER=true

# --- web ---
DOCCHAT_ALLOWED_ORIGINS=*
